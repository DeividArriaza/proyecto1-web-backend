# Copia este archivo a `.env` y ajusta lo que necesites.
# `docker-compose` lee `.env` automáticamente.

# --- Postgres (lo usa el servicio `db` y la API) ---
POSTGRES_USER=games
POSTGRES_PASSWORD=games_pw
POSTGRES_DB=games_tracker

# --- API ---
# DSN que utiliza el backend en Go. Dentro de docker-compose el host es `db`.
DATABASE_URL=postgres://games:games_pw@db:5432/games_tracker?sslmode=disable
API_PORT=8787

# --- Mapeo de puertos al host (cámbialos si 15432 / 8787 / 4567 ya están en uso) ---
DB_HOST_PORT=15432
API_HOST_PORT=8787
FRONTEND_HOST_PORT=4567

# --- Ruta al repo del frontend (relativa a este docker-compose) ---
# Por defecto se asume que clonaste ambos repos al mismo nivel con sus
# nombres de GitHub (proyecto1-web-frontend). Si renombraste la carpeta
# del frontend en local, definí esto a la ruta correcta.
# FRONTEND_PATH=../proyecto1-web-frontend
